rules_version = '2';

// Regras de segurança do Sistema de Notas.
// Perfis: admin (coordenação/direção), titular (suas turmas, todas as disciplinas menos Inglês),
// ingles (Inglês em todas as turmas). Quem não tem perfil ativo não lê nem grava nada.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function perfil() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ativo() { return temPerfil() && perfil().ativo == true; }
    function isAdmin() { return ativo() && perfil().role == 'admin'; }
    function isTitular() { return ativo() && perfil().role == 'titular'; }
    function isIngles() { return ativo() && perfil().role == 'ingles'; }
    function titularDa(turmaId) { return isTitular() && turmaId in perfil().turmas; }
    // Autor de um planejamento: a conta atual ou uma conta antiga da mesma pessoa (antes de gerar nova senha).
    function meu(autorUid) {
      return ativo() && (autorUid == request.auth.uid || autorUid in perfil().get('uidsAnteriores', []));
    }

    function podeVer(turmaId, disc) {
      return isAdmin() || titularDa(turmaId) || (isIngles() && disc == 'ingles');
    }
    function podeEditar(turmaId, disc) {
      return isAdmin() || (titularDa(turmaId) && disc != 'ingles') || (isIngles() && disc == 'ingles');
    }
    function escola() { return get(/databases/$(database)/documents/config/escola).data; }
    // Ano letivo em andamento ("2026"). Só ele recebe lançamentos; os anteriores ficam só para consulta.
    function anoAtivo() { return string(escola().ano); }
    function travado(bim) { return escola().get('travas', {}).get(bim, false) == true; }
    function discValida(d) {
      return d in ['portugues', 'matematica', 'ciencias', 'historia', 'geografia', 'ingles', 'artes', 'edfisica'];
    }

    // Marca de "sistema já configurado". Criada uma única vez, junto com o primeiro admin.
    match /config/setup {
      allow get: if true;
      allow create: if logado()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // O ano letivo só anda para a frente, de um em um, e só se o ano que termina foi arquivado
    // no mesmo lote (anos/{ano}). Assim ninguém "volta" um ano nem pula o arquivamento.
    match /config/escola {
      allow get: if ativo();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (string(request.resource.data.ano) == string(resource.data.ano)
            || (int(request.resource.data.ano) == int(resource.data.ano) + 1
                && existsAfter(/databases/$(database)/documents/anos/$(string(resource.data.ano)))));
      allow delete: if false;
    }

    // Arquivo de cada ano letivo encerrado (dados da escola, turmas e professoras daquele ano).
    // Criado uma única vez, na virada do ano, e nunca mais alterado ou apagado.
    match /anos/{ano} {
      allow read: if isAdmin();
      allow create: if isAdmin() && ano == anoAtivo() && string(request.resource.data.ano) == ano;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if logado() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Admin cria qualquer perfil. Exceção: o PRIMEIRO acesso cria a si mesmo como admin,
      // e só enquanto o sistema ainda não foi configurado.
      allow create: if isAdmin()
        || (logado() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/config/setup)
            && existsAfter(/databases/$(database)/documents/config/setup)
            && request.resource.data.role == 'admin'
            && request.resource.data.ativo == true);
      allow update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Nome de usuário -> conta atual. Lido antes do login (só contém o e-mail interno), gravado pela coordenação.
    match /logins/{usuario} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /turmas/{id} {
      allow read: if ativo();
      allow write: if isAdmin();
    }

    // Aluno que sai da escola não é apagado: fica com turmaId vazio e o histórico em matriculas.
    // Só dá para apagar quem nunca esteve matriculado num ano anterior (ex.: cadastro feito por engano).
    match /alunos/{id} {
      allow read: if isAdmin() || isIngles() || titularDa(resource.data.turmaId);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && resource.data.get('matriculas', {}).keys().hasOnly([anoAtivo()]);
    }

    // Uma planilha = ano + turma + disciplina + bimestre. Código: ANO__turma__disciplina__bimestre.
    // Notas NUNCA são apagadas. Anos encerrados ficam somente leitura (a coordenação só pode
    // recriar uma planilha que esteja faltando, a partir da cópia de segurança, nunca alterar).
    match /planilhas/{pid} {
      function p() { return pid.split('__'); }
      function valida() {
        return p().size() == 4
          && discValida(p()[2])
          && p()[3] in ['1', '2', '3', '4']
          && string(request.resource.data.ano) == p()[0]
          && request.resource.data.turmaId == p()[1]
          && request.resource.data.disc == p()[2]
          && string(request.resource.data.bim) == p()[3]
          && request.resource.data.alunos is map;
      }
      function editavelAgora() {
        return p()[0] == anoAtivo() && podeEditar(p()[1], p()[2]) && (isAdmin() || !travado(p()[3]));
      }
      allow get: if (p().size() == 4 && (isAdmin() || (p()[0] == anoAtivo() && podeVer(p()[1], p()[2]))))
        || (p().size() == 3 && isAdmin());
      allow list: if isAdmin()
        || (string(resource.data.ano) == anoAtivo()
            && (titularDa(resource.data.turmaId) || (isIngles() && resource.data.disc == 'ingles')));
      allow create: if valida() && (editavelAgora() || (isAdmin() && p()[0] != anoAtivo()));
      allow update: if valida() && editavelAgora();
      allow delete: if false;
    }
      // Planejamentos: cada professora vê só os próprios; a coordenação vê todos.
    // O arquivo fica dividido em partes (subcoleção), porque o armazenamento de arquivos do Firebase é pago.
    function planDe(id) { return get(/databases/$(database)/documents/planejamentos/$(id)).data; }
    match /planejamentos/{id} {
      allow read: if isAdmin() || meu(resource.data.autorUid);
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['autorUid', 'autorNome', 'periodo', 'turmas', 'turmasNomes', 'nota',
             'nomeArquivo', 'tipo', 'tamanho', 'bimestre', 'partes', 'status', 'comentario', 'enviadoEm'])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorNome == perfil().get('nome', '')
        && request.resource.data.enviadoEm == request.time
        && request.resource.data.comentario == ''
        && request.resource.data.nomeArquivo.matches('(?i).+[.](pdf|docx?|odt|xlsx?|ods|pptx?|odp|jpe?g|png)')
        && request.resource.data.status == 'enviado'
        && request.resource.data.partes is int
        && request.resource.data.partes >= 1 && request.resource.data.partes <= 10
        && request.resource.data.nomeArquivo is string
        && request.resource.data.periodo is string;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'comentario', 'avaliadoEm', 'avaliadoPor', 'avaliadoPorNome'])
        && request.resource.data.status in ['enviado', 'visto', 'aprovado', 'ajustar'];
      allow delete: if isAdmin() || (meu(resource.data.autorUid) && resource.data.status == 'enviado');

      match /partes/{n} {
        allow read: if isAdmin() || meu(planDe(id).autorUid);
        allow create: if ativo()
          && getAfter(/databases/$(database)/documents/planejamentos/$(id)).data.autorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is string
          && request.resource.data.d.size() < 1000000;
        allow update: if false;
        allow delete: if isAdmin() || (meu(planDe(id).autorUid) && planDe(id).status == 'enviado');
      }
    }
  }
}
